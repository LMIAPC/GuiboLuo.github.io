<link rel="stylesheet" href="{{ '/assets/css/join.css' | relative_url }}">
{% assign op = include.content %}
<div id="join-page" class="op-page" lang="{{ op.locale }}">
  <section class="op-hero" aria-labelledby="op-hero-title">
    <div class="op-shell op-hero-grid">
      <div class="op-hero-copy">
        <nav class="op-local-switch" aria-label="Language">
          {% if op.locale == 'zh-CN' %}
            <a href="{{ '/openings/' | relative_url }}" lang="en">English</a><span aria-hidden="true">/</span><span aria-current="page">中文</span>
          {% else %}
            <span aria-current="page">English</span><span aria-hidden="true">/</span><a href="{{ '/zh/openings/' | relative_url }}" lang="zh-CN">中文</a>
          {% endif %}
        </nav>
        <p class="op-kicker"><span class="op-kicker-line" aria-hidden="true"></span>{{ op.hero.kicker | escape }}</p>
        <h1 id="op-hero-title">{{ op.hero.title_before | escape }}<em>{{ op.hero.title_emphasis | escape }}</em>{{ op.hero.title_after | escape }}</h1>
        <p class="op-lead">{{ op.hero.lead | escape }}</p>
        <div class="op-highlights" aria-label="Group highlights">
          {% for h in op.hero.highlights %}<span>{% if h.number != empty %}<strong>{{ h.number | escape }}</strong>{% endif %} {{ h.text | escape }}</span>{% endfor %}
        </div>
        <div class="op-hero-actions">
          <a class="op-button op-button-primary" href="#opportunities">{{ op.hero.primary_button | escape }}</a>
          <a class="op-button op-button-plain" href="#research">{{ op.hero.secondary_button | escape }}</a>
        </div>
      </div>
      <aside class="op-hero-art" aria-label="AI research illustration">
        <div class="op-orbit op-orbit-one"></div><div class="op-orbit op-orbit-two"></div>
        <div class="op-node op-node-top">{{ op.hero.art.top | escape }}</div>
        <div class="op-node op-node-right">{{ op.hero.art.right | escape }}</div>
        <div class="op-node op-node-bottom">{{ op.hero.art.bottom | escape }}</div>
        <div class="op-center-symbol"><span>{{ op.hero.art.center_top | escape }}</span><b>{{ op.hero.art.center_label | escape }}</b><small>{{ op.hero.art.center_bottom | escape }}</small></div>
        <p class="op-art-caption">{{ op.hero.art.caption | escape }}</p>
      </aside>
    </div>
  </section>
  <section class="op-section op-section-research" id="research" aria-labelledby="research-h">
    <div class="op-shell">
      <div class="op-section-heading"><div><p class="op-section-number">{{ op.research.eyebrow | escape }}</p><h2 id="research-h">{{ op.research.heading | escape }}</h2></div><p>{{ op.research.intro | escape }}</p></div>
      <div class="op-research-grid">
        {% for item in op.research.items %}
        <article class="op-research-card{% if item.featured %} op-research-main{% endif %}">
          <div class="op-research-card-top"><span class="op-research-num">{{ item.number | escape }}</span><span class="op-research-category">{{ item.category | escape }}</span></div>
          <h3>{{ item.heading | escape }}</h3><p>{{ item.text | escape }}</p>
        </article>
        {% endfor %}
      </div>
      <p class="op-under-note">{{ op.research.footnote | escape }}</p>
    </div>
  </section>
  <section class="op-section op-section-positions" id="opportunities" aria-labelledby="positions-h">
    <div class="op-shell">
      <div class="op-section-heading"><div><p class="op-section-number">{{ op.positions.eyebrow | escape }}</p><h2 id="positions-h">{{ op.positions.heading | escape }}</h2></div><p>{{ op.positions.intro | escape }}</p></div>
      <div class="op-role-overview">
        {% for role in op.positions.roles %}
        <a class="op-role-card" href="#{{ role.id }}" data-role="{{ role.id }}">
          <span class="op-role-icon" aria-hidden="true">{{ role.number | escape }}</span><h3>{{ role.name | escape }}</h3><p>{{ role.summary | escape }}</p>
          <div class="op-role-foot"><span>{{ role.label | escape }}</span><span aria-hidden="true">↗</span></div>
        </a>
        {% endfor %}
      </div>
      <div class="op-detail-intro"><h3>{{ op.positions.detail_heading | escape }}</h3><p>{{ op.positions.detail_intro | escape }}</p></div>
      <div class="op-details-stack">
        {% for role in op.positions.roles %}
        <details class="op-role-detail" id="{{ role.id }}">
          <summary><span class="op-detail-number">{{ role.number | escape }}</span><span class="op-detail-title"><b>{{ role.name | escape }}</b><small>{{ role.subtitle | escape }}</small></span><span class="op-plus" aria-hidden="true"></span></summary>
          <div class="op-detail-body">
            <div class="op-detail-col"><h4>{{ role.look_for_label | escape }}</h4><ul>{% for entry in role.look_for %}<li>{{ entry | escape }}</li>{% endfor %}</ul></div>
            <div class="op-detail-col"><h4>{{ role.develop_label | escape }}</h4><ul>{% for entry in role.develop %}<li>{{ entry | escape }}</li>{% endfor %}</ul></div>
            <div class="op-detail-note"><strong>{{ role.note_label | escape }}</strong><p>{{ role.note | escape }}</p></div>
            {% if role.compensation %}
            <div class="op-compensation"><span class="op-compensation-label">{{ role.compensation.label | escape }}</span><strong>{{ role.compensation.amount | escape }}</strong><span>{{ role.compensation.qualifier | escape }}</span></div>
            {% endif %}
            {% if role.contact_url and role.contact_label %}<a class="op-inline-link" href="{{ role.contact_url | escape }}">{{ role.contact_label | escape }} ↗</a>{% endif %}
          </div>
        </details>
        {% endfor %}
      </div>
      <p class="op-under-note">{{ op.positions.footnote | escape }}</p>
    </div>
  </section>
  <section class="op-section op-section-values" id="principles" aria-labelledby="values-h">
    <div class="op-shell">
      <div class="op-section-heading"><div><p class="op-section-number">{{ op.values.eyebrow | escape }}</p><h2 id="values-h">{{ op.values.heading | escape }}</h2></div><p>{{ op.values.intro | escape }}</p></div>
      <div class="op-values-grid">
        {% for item in op.values.items %}
        <article class="op-value-item"><span class="op-value-counter">{{ item.number | escape }}</span><h3>{{ item.heading | escape }}</h3><p>{{ item.text | escape }}</p></article>
        {% endfor %}
      </div>
      <div class="op-ai-note"><span class="op-ai-symbol" aria-hidden="true">✳</span><p>{{ op.values.ai_note | escape }}</p></div>
    </div>
  </section>
  <section class="op-section op-section-support" id="support" aria-labelledby="support-h">
    <div class="op-shell op-support-grid"><div><p class="op-section-number">{{ op.support.eyebrow | escape }}</p><h2 id="support-h">{{ op.support.heading | escape }}</h2><p class="op-support-lead">{{ op.support.intro | escape }}</p></div>
      <div class="op-support-items">{% for item in op.support.items %}<div class="op-support-item"><span class="op-support-dot" aria-hidden="true"></span><p>{{ item | escape }}</p></div>{% endfor %}</div>
    </div>
  </section>
  <section class="op-section op-section-apply" id="apply" aria-labelledby="apply-h">
    <div class="op-shell op-apply-panel">
      <div class="op-apply-top"><div><p class="op-section-number">{{ op.apply.eyebrow | escape }}</p><h2 id="apply-h">{{ op.apply.heading | escape }}</h2><p>{{ op.apply.intro | escape }}</p></div>
        <div class="op-apply-right"><span class="op-email-label">{{ op.apply.email_label | escape }}</span>{% if op.apply.email contains ' at ' %}<span class="op-email-obfuscated">{{ op.apply.email | escape }}</span>{% else %}<a href="mailto:{{ op.apply.email | escape }}">{{ op.apply.email | escape }}</a>{% endif %}</div>
      </div>
      <div class="op-apply-body">{% for item in op.apply.items %}<div><h3>{{ item.heading | escape }}</h3><p>{{ item.text | escape }}</p></div>{% endfor %}</div>
      <div class="op-apply-footer"><a class="op-button op-button-primary" href="{{ op.apply.button_url | escape }}">{{ op.apply.button_label | escape }} ↗</a><span>{{ op.apply.footer | escape }}</span></div>
    </div>
  </section>
</div>
<script>
(function () {
  function openSelectedRole() {
    var target = document.getElementById(window.location.hash.slice(1));
    if (target && target.tagName === 'DETAILS') target.open = true;
  }
  document.addEventListener('click', function (event) {
    var link = event.target.closest('#join-page a[data-role]');
    if (!link) return;
    var target = document.getElementById(link.getAttribute('data-role'));
    if (target && target.tagName === 'DETAILS') target.open = true;
  });
  window.addEventListener('hashchange',openSelectedRole);
  openSelectedRole();
})();
</script>
